{
  "name": "personal-ledger-react",
  "description": "React frontend for a personal ledger application with gRPC backend",
  "private": true,
  "version": "0.0.0",
  "author": "Ian Teda",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IanTeda/personal-ledger-react.git"
  },
  "bugs": {
    "url": "https://github.com/IanTeda/personal-ledger-react/issues"
  },
  "homepage": "https://github.com/IanTeda/personal-ledger-react#readme",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "grpc",
    "personal-ledger"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:protoc": "protoc --experimental_allow_proto3_optional --proto_path=proto --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=src/generated proto/*.proto",
    "build": "pnpm run build:protoc && tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-router": "^1.139.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/router-plugin": "^1.139.12",
    "@tanstack/router-vite-plugin": "^1.139.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "config": {
    "protocVersion": "29.2"
  }
}
