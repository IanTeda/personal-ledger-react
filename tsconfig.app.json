// Application-specific TypeScript configuration for personal-ledger-react
// This config defines compiler options for the React app source code in src/.
// It includes settings for Vite compatibility, strict type checking, and path aliases.
// Referenced by the root tsconfig.json for modular compilation.

{
  "compilerOptions": {
    // Path to store incremental compilation information for faster rebuilds
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Target ECMAScript version for compiled JavaScript output
    "target": "ES2022",
    // Use the standard class fields semantics for properties
    "useDefineForClassFields": true,
    // Include type definitions for ES2022, DOM, and iterable DOM APIs
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Use ESNext module system for better tree-shaking
    "module": "ESNext",
    // Include Vite client types for development
    "types": ["vite/client"],
    // Skip type checking of declaration files for faster compilation
    "skipLibCheck": true,
    // Base directory for resolving non-relative module names
    "baseUrl": ".",
    // Path mapping for absolute imports using @ alias
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    /* Bundler mode settings for Vite compatibility */
    // Use bundler resolution algorithm for modules
    "moduleResolution": "bundler",
    // Allow importing TypeScript extensions in import statements
    "allowImportingTsExtensions": true,
    // Enforce explicit type imports for better module syntax
    "verbatimModuleSyntax": true,
    // Force module detection to ensure proper module handling
    "moduleDetection": "force",
    // Do not emit JavaScript files (handled by Vite)
    "noEmit": true,
    // Use React's new JSX transform
    "jsx": "react-jsx",

    /* Linting and strict type checking */
    // Enable all strict type checking options
    "strict": true,
    // Report errors on unused local variables
    "noUnusedLocals": true,
    // Report errors on unused function parameters
    "noUnusedParameters": true,
    // Allow only erasable TypeScript syntax for better compatibility
    "erasableSyntaxOnly": true,
    // Report errors on fallthrough cases in switch statements
    "noFallthroughCasesInSwitch": true,
    // Report errors on unchecked side effect imports
    "noUncheckedSideEffectImports": true,
    
  },
  // Include source files from the src directory for compilation
  "include": ["src"]
}
